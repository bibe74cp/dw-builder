# ──────────────────────────────────────────────────────────────────────────────
# Variabili d'ambiente per docker compose in locale
# Copiare in .env e adattare i valori prima di avviare i container.
#
#   cp .env.docker .env
#   docker compose up -d
#
# ATTENZIONE: non committare .env con credenziali reali.
# ──────────────────────────────────────────────────────────────────────────────

# Password SA di SQL Server (min 8 car., maiusc., minusc., cifra, carattere speciale)
SA_PASSWORD=DwBuilder_Dev_2025!

# Chiave JWT — almeno 32 caratteri
JWT_KEY=DwBuilder_JWT_LocalDev_SecretKey_32chars!

# Chiave AES-256 per cifratura password sorgenti — base64 di 32 byte
# Generare con: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }) -as [byte[]])
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
