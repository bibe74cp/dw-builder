# DW-Builder Production Environment Variables
# Copy this file to .env.production and fill in actual values
# IMPORTANT: Never commit .env.production to source control!

# ===================================================
# DATABASE CONNECTION
# ===================================================
# SQL Server connection string
# Example: Server=sql-prod-01.database.windows.net,1433;Database=DwBuilderDW;User Id=dwbuilder_user;Password=YourStrongPassword123!;
DB_CONNECTION_STRING=Server=__SQL_SERVER__;Database=DwBuilderDW;User Id=__DB_USER__;Password=__DB_PASSWORD__;TrustServerCertificate=False;Encrypt=True;

# ===================================================
# JWT AUTHENTICATION
# ===================================================
# JWT signing key (minimum 64 bytes base64-encoded)
# Generate with: openssl rand -base64 64
# Example: kJ8v7YnZ...
JWT_KEY=

# JWT Issuer (usually your API URL)
JWT_ISSUER=https://dwbuilder.yourdomain.com

# JWT Audience (usually same as issuer)
JWT_AUDIENCE=https://dwbuilder.yourdomain.com

# JWT token expiry in minutes (default: 60)
JWT_EXPIRY_MINUTES=60

# ===================================================
# ENCRYPTION
# ===================================================
# AES-256 encryption key (must be 32 bytes base64-encoded)
# Generate with: openssl rand -base64 32
# Example: xK9mT2...
ENCRYPTION_KEY=

# ===================================================
# CORS CONFIGURATION
# ===================================================
# Allowed origins for CORS (comma-separated)
# Example: https://dwbuilder.yourdomain.com,https://app.yourdomain.com
ALLOWED_CORS_ORIGINS=https://dwbuilder.yourdomain.com

# ===================================================
# HOSTING
# ===================================================
# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Production

# HTTPS port (default: 443)
ASPNETCORE_HTTPS_PORT=443

# HTTP URLs to listen on
ASPNETCORE_URLS=https://+:443;http://+:80

# ===================================================
# LOGGING
# ===================================================
# Log file path (ensure directory exists and has write permissions)
LOG_FILE_PATH=/var/log/dwbuilder/dwbuilder-.log

# Minimum log level (Trace, Debug, Information, Warning, Error, Critical)
LOG_LEVEL=Information

# ===================================================
# AZURE KEY VAULT (Optional)
# ===================================================
# If using Azure Key Vault for secrets management
# AZURE_KEY_VAULT_URI=https://your-keyvault.vault.azure.net/
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=

# ===================================================
# HEALTH CHECKS
# ===================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_DB_INTERVAL_SECONDS=30

# ===================================================
# GENERATION INSTRUCTIONS
# ===================================================
# 1. Generate JWT key:
#    openssl rand -base64 64
#
# 2. Generate encryption key:
#    openssl rand -base64 32
#
# 3. Update connection string with actual server/credentials
#
# 4. Update CORS origins with actual frontend URL
#
# 5. Rename this file to .env.production (without .template)
#
# 6. Add .env.production to .gitignore (should already be there)
#
# 7. On production server, load these variables before starting:
#    Linux: export $(cat .env.production | xargs)
#    Windows: Get-Content .env.production | ForEach-Object { $var = $_.Split('='); [Environment]::SetEnvironmentVariable($var[0], $var[1]) }
