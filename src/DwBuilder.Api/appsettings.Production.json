{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "AllowedHosts": "*.yourdomain.com",
  "ConnectionStrings": {
    "DwBuilder": "Server=__PRODUCTION_SQL_SERVER__;Database=DwBuilderDW;User Id=__DB_USER__;Password=__DB_PASSWORD__;TrustServerCertificate=False;Encrypt=True;Connection Timeout=30;"
  },
  "Jwt": {
    "Issuer": "https://dwbuilder.yourdomain.com",
    "Audience": "https://dwbuilder.yourdomain.com",
    "Key": "__JWT_SECRET_KEY__",
    "ExpiryMinutes": 60
  },
  "Encryption": {
    "Key": "__ENCRYPTION_KEY__"
  },
  "AllowedCorsOrigins": "https://dwbuilder.yourdomain.com",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/dwbuilder/dwbuilder-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DwBuilder",
          "tableName": "Logs",
          "schemaName": "_meta",
          "autoCreateSqlTable": false,
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "HealthChecks": {
    "Enabled": true,
    "DatabaseCheckIntervalSeconds": 30
  }
}
